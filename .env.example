# Free API key from https://www.football-data.org/client/register
# Kept server-side by the Vite proxy – never exposed to the browser.
FOOTBALL_DATA_API_KEY=

# Optional: which competitions to show (comma-separated football-data.org codes).
# Defaults to everything on the free tier:
# PL,ELC,PD,BL1,SA,FL1,DED,PPL,BSA,CL,EC,WC
FOOTBALL_DATA_COMPETITIONS=
