# Server-side settings. On Vercel, set these under Project → Settings →
# Environment Variables instead, then redeploy. Keys are only read by the
# /api functions and are never sent to the browser.

# ---- Football data (set ONE of these; API-Football is used if both are set) ----

# API-Football: 1,000+ leagues and cups including second/third divisions,
# live scores, squads, player stats and transfers.
# Key from https://dashboard.api-football.com/register
API_FOOTBALL_KEY=
# Requests per minute your plan allows (check your API-Football dashboard).
API_FOOTBALL_REQUESTS_PER_MINUTE=10

# football-data.org: top leagues, Champions League, World Cup and Euros (free).
# Key from https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=
# Optional: which competitions to show (comma-separated codes).
# Defaults to everything on the free tier: PL,ELC,PD,BL1,SA,FL1,DED,PPL,BSA,CL,EC,WC
FOOTBALL_DATA_COMPETITIONS=

# How often live scores refresh, in seconds (minimum 5). Every refresh is one
# request, so keep this within your plan's per-minute limit.
LIVE_REFRESH_SECONDS=20

# ---- News ----
# Free developer key for football news from The Guardian:
# https://open-platform.theguardian.com/access/
GUARDIAN_API_KEY=

# ---- Accounts ----
# Redis for storing accounts (Upstash REST API). On Vercel, add "Upstash for
# Redis" under Storage and these are set for you. Locally, leave them empty
# and accounts are kept in .footiq-dev-db.json.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ---- Extra match details (line-ups, goals, cards, subs, stats) ----
# Used when the main data source doesn't include them. OpenLigaDB (German
# leagues) and StatsBomb Open Data (selected past tournaments and seasons) need
# no key. Sportmonks covers the leagues on your plan: https://www.sportmonks.com
SPORTMONKS_API_TOKEN=
