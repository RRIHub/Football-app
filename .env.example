# Free API key from https://www.football-data.org/client/register
# Kept server-side by the Vite proxy – never exposed to the browser.
FOOTBALL_DATA_API_KEY=

# Optional: which competitions to show (comma-separated football-data.org codes).
# Defaults to everything on the free tier:
# PL,ELC,PD,BL1,SA,FL1,DED,PPL,BSA,CL,EC,WC
FOOTBALL_DATA_COMPETITIONS=

# How often live scores refresh, in seconds (minimum 5). Every refresh is one
# request: the free tier allows 10/minute in total, so keep this at 20 or more
# unless your plan allows more.
LIVE_REFRESH_SECONDS=20

# Free developer key for football news from The Guardian:
# https://open-platform.theguardian.com/access/
GUARDIAN_API_KEY=
